{
  "info": {
    "name": "API failure modes and how I diagnose them",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Happy paths plus deliberate failures (401/403/400/404/409/429/slow). Each failure request description has symptom, what the response revealed, and the fix."
  },
  "item": [
    {
      "name": "1 Happy paths",
      "item": [
        {
          "name": "GET /user (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{github_token}}"
              }
            ],
            "url": "{{github_base}}/user",
            "description": "Happy path. Needs a valid token in the environment (read-only is enough)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response under 5s (first request includes DNS/TLS)', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test('schema', () => pm.response.to.have.jsonSchema({type:'object', required:['login','id'], properties:{login:{type:'string'}, id:{type:'number'}}}));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /repos/{owner}/{repo} (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{github_token}}"
              }
            ],
            "url": "{{github_base}}/repos/{{owner}}/{{repo}}",
            "description": "Happy path for a public repo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('schema', () => pm.response.to.have.jsonSchema({type:'object', required:['full_name','private'], properties:{full_name:{type:'string'}, private:{type:'boolean'}}}));",
                  "pm.test('rate limit headers present', () => { pm.expect(pm.response.headers.has('x-ratelimit-remaining')).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rate_limit (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{github_token}}"
              }
            ],
            "url": "{{github_base}}/rate_limit",
            "description": "Shows the budget you have left. Check this first when you suspect throttling."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has core limit', () => pm.expect(pm.response.json().resources.core).to.have.property('remaining'));"
                ]
              }
            }
          ]
        },
        {
          "name": "LAB POST /v1/subscriptions (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{lab_base}}/v1/subscriptions",
            "description": "Happy path against the local failure lab. Resets state first so reruns are repeatable.",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"demo-plan\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('has id', () => pm.expect(pm.response.json().id).to.be.a('string'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({url: pm.variables.get('lab_base') + '/v1/reset', method: 'POST'}, () => {});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Deliberate failures",
      "item": [
        {
          "name": "F1 401 bad token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              },
              {
                "key": "Authorization",
                "value": "Bearer invalid-token-for-testing",
                "description": "deliberately invalid"
              }
            ],
            "url": "{{github_base}}/user",
            "description": "SYMPTOM: every call fails with 401 'Bad credentials'. REVEALED: body message plus no x-ratelimit budget for your user. FIX: token expired/revoked/typo - regenerate, confirm the Authorization scheme, and check the env variable is actually populated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('message says bad credentials', () => pm.expect(pm.response.json().message).to.match(/credentials/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "F2 403 missing permission",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{github_token}}"
              }
            ],
            "url": "{{github_base}}/repos/octocat/Hello-World",
            "description": "SYMPTOM: authenticated call refused with 403. REVEALED: message says admin rights/permission needed; 403 (known you, not allowed) differs from 401 (do not know you). FIX: grant the scope/permission or use an account that owns the resource. NOTE: verify the exact message on first live run.",
            "body": {
              "mode": "raw",
              "raw": "{\"description\": \"should not be allowed\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden (or 404 if the API hides it)', () => pm.expect([403, 404]).to.include(pm.response.code));",
                  "pm.test('has a message', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ]
        },
        {
          "name": "F3 400 malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{github_token}}"
              }
            ],
            "url": "{{github_base}}/markdown",
            "description": "SYMPTOM: 400 on a POST that looks fine. REVEALED: message about parsing JSON. FIX: validate the body (missing quote, wrong Content-Type) before blaming the API. OBSERVED: a truncated body with a trailing comma was accepted by /markdown (200), so parsers differ in strictness - do not assume every malformed body gives a 400.",
            "body": {
              "mode": "raw",
              "raw": "{\"text\": hello}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('error body mentions JSON/parsing (if body is JSON)', () => { let m = ''; try { m = pm.response.json().message || ''; } catch (e) { m = ''; } pm.expect(m).to.match(/json|pars/i); });"
                ]
              }
            }
          ]
        },
        {
          "name": "F4 404 nonexistent resource",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{github_token}}"
              }
            ],
            "url": "{{github_base}}/repos/{{owner}}/this-repo-does-not-exist-xyz",
            "description": "SYMPTOM: 404 for something you expect to exist. REVEALED: also what private resources return without access, so check path, ID, environment (test vs live) and permissions. FIX: correct the identifier or the credential's access."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "F5 409 duplicate create (2 requests)",
          "item": [
            {
              "name": "F5a create (201)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{lab_base}}/v1/subscriptions",
                "description": "First create succeeds.",
                "body": {
                  "mode": "raw",
                  "raw": "{\"name\": \"dup-test\"}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('201 Created', () => pm.response.to.have.status(201));"
                    ]
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.sendRequest({url: pm.variables.get('lab_base') + '/v1/reset', method: 'POST'}, () => {});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "F5b same create again (409)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{lab_base}}/v1/subscriptions",
                "description": "SYMPTOM: 'duplicate request' - retry created a second object or errored. REVEALED: 409 with already_exists. FIX: treat 409 as 'already done' after a timeout/retry; use an idempotency key so a retry returns the original result.",
                "body": {
                  "mode": "raw",
                  "raw": "{\"name\": \"dup-test\"}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                      "pm.test('error is already_exists', () => pm.expect(pm.response.json().error).to.eql('already_exists'));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "F6 429 rate limited",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{lab_base}}/v1/limited",
            "description": "SYMPTOM: intermittent failures that clear on their own. REVEALED: 429 plus Retry-After header saying how long to wait. FIX: back off for Retry-After seconds (with jitter), stop parallel bursts, cache or batch."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('429 Too Many Requests', () => pm.response.to.have.status(429));",
                  "pm.test('Retry-After header present', () => pm.expect(pm.response.headers.get('Retry-After')).to.exist);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const url = pm.variables.get('lab_base') + '/v1/limited';",
                  "pm.sendRequest({url: pm.variables.get('lab_base') + '/v1/reset', method: 'POST'}, () => {",
                  "  let n = 0; (function hit(){ if (n++ < 3) pm.sendRequest(url, hit); })();",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "F7 slow response / timeout",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{lab_base}}/v1/slow?delay=3",
            "description": "SYMPTOM: 'it hangs' or client times out though the server eventually answers. REVEALED: response time in Postman vs your client timeout. FIX: separate client timeout from server slowness; set explicit timeouts and retry only idempotent calls. To see a real timeout error, set Postman request timeout to 1000 ms (or run newman with --timeout-request 1000)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answered, but slowly (>2.5s)', () => pm.expect(pm.response.responseTime).to.be.above(2500));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}