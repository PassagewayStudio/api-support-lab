# Copy to .env (never commit .env). Replace every value.
LAB_DB_NAME=webhook_lab
LAB_DB_USER=lab_user
LAB_DB_PASSWORD=change-me-to-a-long-random-string
# Generate with: python3 -c "import os,base64;print('whsec_'+base64.b64encode(os.urandom(24)).decode())"
WEBHOOK_SECRET=whsec_replace_me
# Slack incoming webhook for failure alerts. Use a personal/free Slack workspace for this lab, not a work one.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLEASE
# Set to true to also alert when no event was processed for 30+ minutes (noisy while the lab is idle)
ALERT_ON_SILENCE=false
